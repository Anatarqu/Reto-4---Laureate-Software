{
  "uid": "exp1",
  "title": "Experimento 1 · Latencia y seguridad",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "experimento-1"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Guardado en el gateway (ms) · REND-01",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(gateway_request_seconds_bucket{resultado=\"ok\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "exemplar": false,
          "interval": ""
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(gateway_request_seconds_bucket{resultado=\"ok\"}[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "exemplar": false,
          "interval": ""
        }
      ],
      "interval": "5s",
      "maxDataPoints": 500
    },
